---
import { loadData } from '../data/load';
import '../styles/global.css';
const data = loadData();
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Your car ownership costs, grounded in actual payments and measured mileage."/><title>Car TCO · Ownership, accounted for</title><link rel="icon" href="/favicon.svg"/></head>
  <body>
    <div class="shell">
      <aside class="sidebar"><a class="brand" href="/" aria-label="Car TCO home"><span class="brand-icon">↗</span> car<span>tco</span></a><p class="nav-label">YOUR GARAGE</p><a class="nav-item active" href="#overview"><span>◫</span> Ownership overview</a><a class="nav-item" href="#costs"><span>≡</span> Cost breakdown</a><a class="nav-item" href="#energy"><span>ϟ</span> Energy & mileage</a><a class="nav-item" href="#records"><span>▤</span> Recorded events</a><div class="sidebar-foot"><span class="status-dot"></span> Local YAML data<p>Actual payments.<br/>A clearer picture of ownership.</p></div></aside>
      <main id="overview">
        <header><div><p class="eyebrow">THE OWNERSHIP LEDGER</p><h1>Every kilometre.<br/><span>Accounted for.</span></h1><p class="intro">Understand what your car really costs, from handover to the road ahead.</p></div><div class="edition">CAR TCO <span>/</span> 01<br/><small>PERSONAL OWNERSHIP DASHBOARD</small></div></header>
        <section class="toolbar" aria-label="Report filters"><label>Vehicle<select id="vehicle">{data.vehicles.map(v=><option value={v.id}>{v.manufacturer} {v.model}</option>)}</select></label><label>Reporting period<select id="period"><option value="lifetime">Lifetime</option></select></label><fieldset><legend>Accounting basis</legend><div class="segmented"><label><input type="radio" name="basis" value="accrual" checked/><span>Accrual</span></label><label><input type="radio" name="basis" value="cash"/><span>Cash</span></label></div></fieldset></section>
        <noscript><p class="notice">Enable JavaScript to calculate and explore the dashboard. Your source data remains in YAML.</p></noscript>
        <div id="dashboard" aria-live="polite"></div>
        <footer><span>CAR TCO <b>·</b> Built on actuals</span><span>YAML source of truth · EUR reporting</span></footer>
      </main>
    </div>
    <script id="dataset" type="application/json" set:html={JSON.stringify(data).replace(/</g,'\\u003c')}></script>
    <script>import '../dashboard';</script>
  </body>
</html>
